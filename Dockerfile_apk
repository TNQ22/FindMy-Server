# === Stage 1: Build Android APK with Flutter ===
FROM instrumentisto/flutter:latest AS apk-builder

WORKDIR /app_android

# Copy Flutter project source
COPY macless_haystack /app_android

# Accept Android SDK licenses
RUN yes | /opt/android-sdk-linux/cmdline-tools/latest/bin/sdkmanager --licenses || true

# Fetch dependencies and compile Release APK
RUN --mount=type=cache,target=/root/.gradle \
    flutter pub get \
    && flutter build apk --release --no-tree-shake-icons

# === Stage 2: Export APK directly to host ===
FROM scratch AS export-stage
COPY --from=apk-builder /app_android/build/app/outputs/flutter-apk/app-release.apk /FindMy-Server-release.apk
